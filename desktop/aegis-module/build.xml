<?xml version="1.0" encoding="UTF-8"?>
<project name="org.sleuthkit.autopsy.aegis" default="netbeans" basedir=".">
    <description>AEGIS sanitization module. Forensic code stays in the existing Autopsy modules.</description>
    <import file="nbproject/build-impl.xml"/>
    <target name="-post-jar">
        <available file="${basedir}/../../sanitizer/aegis_cli.exe" property="aegis.cli.present"/>
        <antcall target="copy-aegis-cli"/>
    </target>
    <target name="copy-aegis-cli" if="aegis.cli.present">
        <mkdir dir="${basedir}/release/bin"/>
        <copy todir="${basedir}/release/bin" file="${basedir}/../../sanitizer/aegis_cli.exe"/>
    </target>
</project>
