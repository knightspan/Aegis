# Local
*.log
.env
.DS_Store

# Evidence / working data — never commit
*.E01
*.dd
*.raw
corpus/
evidence/

# Hardware validation runs. The numbers are written up in
# docs/validation/hardware.md; the raw output is local evidence, not source.
# One run is 7.3 GB of PhotoRec output, and its ledger and signing key are
# root-owned 0600 by design.
docs/validation/results-*/

# Demo fallback media: large recordings, plus a report and ledger from a
# scratch state directory. docs/demo/fallback/README.md says how to make them.
docs/demo/fallback/*
!docs/demo/fallback/README.md
docs/validation/results-*/keys/*.key.pem
core/platform/build_info.json
